@model IEnumerable<SBiPayrollWeb.Entities.Department>
@{
    ViewBag.Title = "Departments";
    int departmentCount = Model != null ? Model.Count() : 0;
}
<link rel="stylesheet" href="~/Content/departments_modern.css" />
<div class="departments-container">
    <!-- Header Section -->
    <div class="page-header">
        <div class="header-title">
            <h2>Departments</h2>
            <span class="badge-count" id="totalCount">@departmentCount</span>
        </div>
        <div class="header-actions">
            @using (Html.BeginForm("CreateDepartment", "DataEntry", FormMethod.Get, new { id = "data-entry-create-department-form" }))
            {
                <button type="submit" id="btnSubmitCreateDepartmentForm" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Create Department
                </button>
            }
        </div>
    </div>
    <!-- Utility Bar: Search & Filters -->
    <div class="table-utilities">
        <div class="search-box">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="departmentSearchInput" placeholder="Search by name, email, or department no..." />
            <button type="button" id="clearSearch" class="btn-clear" style="display: none;">&times;</button>
        </div>
        <div class="page-size-selector">
            <label for="pageSizeSelect">Rows per page:</label>
            <select id="pageSizeSelect">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
    <!-- Table Container -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="modern-table" id="departmentsTable">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.Code)</th>
                        <th>@Html.DisplayNameFor(model => model.Description)</th> 
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="departmentTableBody">
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.Id">
                            <td class="font-medium">@Html.DisplayFor(modelItem => item.Id)</td>
                            <td class="font-medium">@Html.DisplayFor(modelItem => item.Code)</td>
                            <td>
                                <div class="user-avatar-cell">
                                    <div class="avatar">@item.Description.Substring(0, 1).ToUpper()</div>
                                    <span class="emp-name">@Html.DisplayFor(modelItem => item.Description)</span>
                                </div>
                            </td> 
                            <td class="text-right actions-cell">
                                @Html.ActionLink("Edit", "EditDepartment", new { id = item.Id }, new { @class = "action-link edit" })
                                @Html.ActionLink("Details", "DepartmentDetails", new { id = item.Id }, new { @class = "action-link details" })
                                @Html.ActionLink("Delete", "DeleteDepartment", new { id = item.Id, description = item.Description }, new { @class = "action-link delete" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="noResults" class="no-results" style="display: none;">
                <p>No matching departments found.</p>
            </div>
        </div>
        <!-- Table Footer Pagination -->
        <div class="pagination-footer">
            <div class="pagination-info" id="paginationInfo">
                Showing 0 to 0 of 0 entries
            </div>
            <div class="pagination-controls" id="paginationControls">
                <!-- Pagination buttons generated by JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- Progress Spinner -->
<div id="progress" class="loading-overlay" style="display: none;">
    <div class="spinner"></div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/departments_modern.js"></script>
}
