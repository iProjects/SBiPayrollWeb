@model SBiPayrollWeb.Entities.Employee
@{
    ViewBag.Title = "Create Employee";
}
<link rel="stylesheet" href="~/Content/create_employee_modern.css" />
<div class="container-fluid py-4">
    <!-- Search Section -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h2 class="h4 mb-0 font-weight-bold text-primary">Employee Management</h2>
                    <p class="text-muted small mb-0">Search existing records or register a new employee.</p>
                </div>
                <div class="col-md-6 mt-3 mt-md-0">
                    <div class="input-group">
                        <input type="text" id="txtEmployeeSearch" class="form-control" placeholder="Search by Employee No, ID, or Name..." />
                        <button class="btn btn-primary" type="button" id="btnSearchEmployee">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
            </div>

            <div id="searchResultsArea" class="mt-3 d-none">
                <div class="table-responsive">
                    <table class="table table-hover table-sm border" id="tblSearchResults">
                        <thead class="table-light">
                            <tr>
                                <th>Emp No</th>
                                <th>Name</th>
                                <th>ID No</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- Form Section -->
    @using (Html.BeginForm("UploadEmployerLogo", "DataEntry", FormMethod.Post, new { enctype = "multipart/form-data", id = "form-employee-entry" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 text-dark">Employee Registration Form</h5>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs mb-4" id="employeeTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal" type="button" role="tab" aria-controls="personal" aria-selected="true">Personal Details</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="payroll-tab" data-bs-toggle="tab" data-bs-target="#payroll" type="button" role="tab" aria-controls="payroll" aria-selected="false">Tax & Statutory</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="employment-tab" data-bs-toggle="tab" data-bs-target="#employment" type="button" role="tab" aria-controls="employment" aria-selected="false">Employment & Banking</button>
                    </li>
                </ul>
                <div class="tab-content" id="employeeTabContent">
                    <!-- Tab 1: Personal Details -->
                    <div class="tab-pane fade show active" id="personal" role="tabpanel" aria-labelledby="personal-tab">
                        <div class="row g-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.EmpNo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.EmpNo, new { @class = "form-control", id = "EmpNo" })
                                @Html.ValidationMessageFor(m => m.EmpNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.Surname, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Surname, new { @class = "form-control", id = "Surname" })
                                @Html.ValidationMessageFor(m => m.Surname, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.OtherNames, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.OtherNames, new { @class = "form-control", id = "OtherNames" })
                                @Html.ValidationMessageFor(m => m.OtherNames, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.DoB, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.DoB, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "DoB" })
                                @Html.ValidationMessageFor(m => m.DoB, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.Gender, new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.Gender, new SelectList(new[] { "Male", "Female", "Other" }), "-- Select Gender --", new { @class = "form-select", id = "Gender" })
                                @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.MaritalStatus, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.MaritalStatus, new { @class = "form-control", id = "MaritalStatus" })
                                @Html.ValidationMessageFor(m => m.MaritalStatus, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.TelephoneNo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.TelephoneNo, new { @class = "form-control", id = "TelephoneNo" })
                                @Html.ValidationMessageFor(m => m.TelephoneNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.IDNo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.IDNo, new { @class = "form-control", id = "IDNo" })
                                @Html.ValidationMessageFor(m => m.IDNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.Photo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Photo, new { @class = "form-control", type = "file", id = "Photo" })
                                @Html.ValidationMessageFor(m => m.Photo, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>
                    <!-- Tab 2: Tax & Statutory Details -->
                    <div class="tab-pane fade" id="payroll" role="tabpanel" aria-labelledby="payroll-tab">
                        <div class="row g-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.PINNo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.PINNo, new { @class = "form-control", id = "PINNo" })
                                @Html.ValidationMessageFor(m => m.PINNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.NSSFNo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.NSSFNo, new { @class = "form-control", id = "NSSFNo" })
                                @Html.ValidationMessageFor(m => m.NSSFNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.NHIFNo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.NHIFNo, new { @class = "form-control", id = "NHIFNo" })
                                @Html.ValidationMessageFor(m => m.NHIFNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.PersonalRelief, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.PersonalRelief, new { @class = "form-control", id = "PersonalRelief" })
                                @Html.ValidationMessageFor(m => m.PersonalRelief, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.MortgageRelief, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.MortgageRelief, new { @class = "form-control", id = "MortgageRelief" })
                                @Html.ValidationMessageFor(m => m.MortgageRelief, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.InsuranceRelief, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.InsuranceRelief, new { @class = "form-control", id = "InsuranceRelief" })
                                @Html.ValidationMessageFor(m => m.InsuranceRelief, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.BasicComputation, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.BasicComputation, new { @class = "form-control", id = "BasicComputation" })
                                @Html.ValidationMessageFor(m => m.BasicComputation, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.BasicPay, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.BasicPay, new { @class = "form-control", id = "BasicPay" })
                                @Html.ValidationMessageFor(m => m.BasicPay, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>
                    <!-- Tab 3: Employment & Banking Details -->
                    <div class="tab-pane fade" id="employment" role="tabpanel" aria-labelledby="employment-tab">
                        <div class="row g-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.DoE, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.DoE, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "DoE" })
                                @Html.ValidationMessageFor(m => m.DoE, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.DepartmentId, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.DepartmentId, new { @class = "form-control", id = "DepartmentId" })
                                @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.EmployerId, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.EmployerId, new { @class = "form-control", id = "EmployerId" })
                                @Html.ValidationMessageFor(m => m.EmployerId, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.PayPoint, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.PayPoint, new { @class = "form-control", id = "PayPoint" })
                                @Html.ValidationMessageFor(m => m.PayPoint, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.EmpGroup, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.EmpGroup, new { @class = "form-control", id = "EmpGroup" })
                                @Html.ValidationMessageFor(m => m.EmpGroup, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.EmpPayroll, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.EmpPayroll, new { @class = "form-control", id = "EmpPayroll" })
                                @Html.ValidationMessageFor(m => m.EmpPayroll, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.BankCode, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.BankCode, new { @class = "form-control", id = "BankCode" })
                                @Html.ValidationMessageFor(m => m.BankCode, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.BankAccount, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.BankAccount, new { @class = "form-control", id = "BankAccount" })
                                @Html.ValidationMessageFor(m => m.BankAccount, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.PaymentMode, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.PaymentMode, new { @class = "form-control", id = "PaymentMode" })
                                @Html.ValidationMessageFor(m => m.PaymentMode, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.LeaveBalance, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.LeaveBalance, new { @class = "form-control", id = "LeaveBalance" })
                                @Html.ValidationMessageFor(m => m.LeaveBalance, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.ChequeNo, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.ChequeNo, new { @class = "form-control", id = "ChequeNo" })
                                @Html.ValidationMessageFor(m => m.ChequeNo, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4 align-self-center mt-4">
                                <div class="form-check form-switch">
                                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActive" })
                                    @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light text-end py-3">
                <button type="reset" class="btn btn-outline-secondary me-2">Reset</button>
                <button type="submit" id="btnSubmit" class="btn btn-primary px-4">Save Employee</button>
            </div>
        </div>
    }
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        var urls = {
            searchEmployees: '@Url.Action("SearchEmployees", "DataEntry")',
            getEmployeeByNo: '@Url.Action("GetEmployeeByNo", "DataEntry")'
        };
    </script>
    <script src="~/Scripts/create_employee_modern.js"></script>
}

