@model SBiPayrollWeb.UI.MVC.Models.LoginModel
@{
    ViewBag.Title = "Log in";
}
<link href="~/Content/login_modern.css" rel="stylesheet" />
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Welcome Back</h2>
            <p>Please enter your details to sign in.</p>
        </div>
        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { enctype = "multipart/form-data", id = "login-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)

            <div class="form-group">
                @Html.LabelFor(m => m.UserName)
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control-custom", @autofocus = "autofocus", placeholder = "username@domain.co.ke", type = "email" })
                @Html.ValidationMessageFor(m => m.UserName)
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                <div class="password-wrapper">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control-custom js-password-input", placeholder = "Enter your password" })
                    <button type="button" class="password-toggle-btn js-password-toggle" aria-label="Toggle password visibility">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.Password)
            </div>

            <div class="checkbox-group">
                @Html.CheckBoxFor(m => m.RememberMe)
                @Html.LabelFor(m => m.RememberMe, new { @class = "checkbox" })
            </div>

            <button type="submit" id="btnSubmitLoginForm" class="btn-primary-custom">Log in</button>
        }
        <div class="divider">
            <span>OR</span>
        </div>
        <section class="social" id="socialLoginForm">
            <!-- Hidden form for posting Google ID Token to backend -->
            @using (Html.BeginForm("GoogleLoginCallback", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { id = "google-login-form" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="google_id_token" name="idToken" />
            }
            <button type="button" id="btn-google-login" class="btn-google-custom" title="Log in using your Google account">
                <svg class="google-icon" viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z" />
                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.11-6.72-4.96H1.29v3.15C3.26 21.3 7.31 24 12 24z" />
                    <path fill="#FBBC05" d="M5.28 14.24c-.25-.72-.38-1.49-.38-2.24s.13-1.52.38-2.24V6.61H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.39l3.99-3.15z" />
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.61l3.99 3.15c.95-2.85 3.6-4.96 6.72-4.96z" />
                </svg>
                <span id="google-btn-text">Sign in with Google</span>
            </button>
        </section>
        <div class="auth-footer">
            Don't have an account? @Html.ActionLink("Register now", "Register", "Account")
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/Scripts/login_modern.js"></script>
}