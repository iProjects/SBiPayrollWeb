@model SBiPayrollWeb.UI.MVC.Models.RegisterModel
@{
    ViewBag.Title = "Register";
}
<link href="~/Content/register_modern.css" rel="stylesheet" />
<div class="auth-wrapper">
    <div class="auth-card wide">
        <div class="auth-header">
            <h2>Create an Account</h2>
            <p>Fill in the required information to get started.</p>
        </div>
        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { enctype = "multipart/form-data", id = "register-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)

            <div class="form-grid-2col">
                <!-- Column 1: Account Credentials -->
                <div class="form-col">
                    <h3 class="form-section-title">Login Credentials</h3>
                    <div class="form-group">
                        @Html.LabelFor(model => model.UserName)
                        @Html.TextBoxFor(model => model.UserName, new { @class = "form-control-custom", placeholder = "username@domain.com" })
                        @Html.ValidationMessageFor(model => model.UserName)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Password)
                        <div class="password-wrapper">
                            @Html.PasswordFor(model => model.Password, new { @class = "form-control-custom js-password-input", placeholder = "Enter password" })
                            <button id="toggle-btn" type="button" class="password-toggle-btn js-password-toggle" aria-label="Toggle password visibility">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(model => model.Password)

                    </div>

                    <!-- Password Strength Indicator UI -->
                    <div class="password-strength-container" id="strengthContainer" style="display: none;">
                        <div class="strength-bar-wrapper">
                            <div class="strength-bar-fill" id="strengthBar"></div>
                        </div>
                        <div class="strength-label-text">
                            Strength: <span id="strengthText">None</span>
                        </div>
                        <ul class="password-criteria-list">
                            <li id="ruleLength" class="invalid">At least 8 characters</li>
                            <li id="ruleLower" class="invalid">Lowercase letter (a-z)</li>
                            <li id="ruleUpper" class="invalid">Uppercase letter (A-Z)</li>
                            <li id="ruleNumber" class="invalid">Number (0-9)</li>
                            <li id="ruleSpecial" class="invalid">Special character (!@@#$%^&*)</li>
                        </ul>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ConfirmPassword)
                        <div class="password-wrapper">
                            @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control-custom js-password-input", placeholder = "Confirm password" })
                            <button type="button" class="password-toggle-btn js-password-toggle" aria-label="Toggle password visibility">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(model => model.ConfirmPassword)
                    </div>
                    <div class="checkbox-group">
                        @Html.CheckBoxFor(model => model.TermsAccepted)
                        @Html.LabelFor(model => model.TermsAccepted, "I accept the terms and conditions")
                    </div>
                    @Html.ValidationMessageFor(model => model.TermsAccepted)
                </div>
                <!-- Column 2: Personal Profile Data -->
                <div class="form-col">
                    <h3 class="form-section-title">Personal Information</h3>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Surname)
                        @Html.TextBoxFor(model => model.Surname, new { @class = "form-control-custom", placeholder = "Surname" })
                        @Html.ValidationMessageFor(model => model.Surname)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.OtherNames)
                        @Html.TextBoxFor(model => model.OtherNames, new { @class = "form-control-custom", placeholder = "Other Names" })
                        @Html.ValidationMessageFor(model => model.OtherNames)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.NationalID)
                        @Html.TextBoxFor(model => model.NationalID, new { @class = "form-control-custom", placeholder = "National ID or Passport" })
                        @Html.ValidationMessageFor(model => model.NationalID)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Gender)
                        @{
            var genderItems = new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Male", Value = "M" },
                                new SelectListItem { Text = "Female", Value = "F" }
                            };
                        }
                        @Html.DropDownListFor(model => model.Gender, genderItems, "-- Select Gender --", new { @class = "form-control-custom", @id = "cboGender" })
                        @Html.ValidationMessageFor(model => model.Gender)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.InformBy)
                        @{
            var informItems = new List<SelectListItem>
                            {
                                new SelectListItem { Text = "SMS", Value = "SMS" },
                                new SelectListItem { Text = "EMAIL", Value = "EMAIL", Selected = true }
                            };
                        }
                        @Html.DropDownListFor(model => model.InformBy, informItems, "-- Select Preferred Notification --", new { @class = "form-control-custom", @id = "cboInformBy" })
                        @Html.ValidationMessageFor(model => model.InformBy)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Telephone)
                        @Html.TextBoxFor(m => m.Telephone, new { @class = "form-control-custom", type = "tel", placeholder = "254717769329" })
                        @Html.ValidationMessageFor(model => model.Telephone)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.DateOfBirth)
                        @{
            var isDefaultDate = Model.DateOfBirth == DateTime.MinValue ||
                                Model.DateOfBirth.ToString("yyyy-MM-dd") == "0001-01-01";
            var dobFormatted = isDefaultDate ? DateTime.Now.ToString("yyyy-MM-dd") : Model.DateOfBirth.ToString("yyyy-MM-dd");
                        }
                        @Html.TextBoxFor(model => model.DateOfBirth, new { Value = dobFormatted, @class = "form-control-custom datepicker", type = "date" })
                        @Html.ValidationMessageFor(model => model.DateOfBirth)
                    </div>
                </div>
            </div>

            <div style="margin-top: 1.5rem;">
                <button type="submit" id="btnSubmitRegisterForm" class="btn-primary-custom">Register</button>
            </div>
        }
        <div class="auth-footer">
            Already have an account? @Html.ActionLink("Log in here", "Login", "Account")
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/Scripts/register_modern.js"></script>
}
