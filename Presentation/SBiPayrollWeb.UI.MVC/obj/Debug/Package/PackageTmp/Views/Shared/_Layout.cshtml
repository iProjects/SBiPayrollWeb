@using SBiPayrollWeb.UI.MVC.Controllers;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Soft Books Payroll</title>
    <link href="~/Dollar.ico" rel="shortcut icon" type="image/x-icon" />
    <!-- Google Fonts & Icon Sets -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    @*@Styles.Render("~/bundles/_AllStyles")*@
    <!-- <link href="~/Content/modern_layout.css" rel="stylesheet" type="text/css" />-->
    @Styles.Render("~/Content/themes/base/css")
    @Styles.Render("~/bundles/modern_css")


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/toast");
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/bootstrap");
    @Scripts.Render("~/bundles/indexdb");
    @* @Scripts.Render("~/bundles/modernizr")
        @Scripts.Render("~/bundles/knockout")
        @Scripts.Render("~/bundles/MicrosoftAjax")
        @Scripts.Render("~/bundles/dataTables")
        @Scripts.Render("~/bundles/tablesorter") *@


</head>
<body>

    <div class="app-container">
        <!-- TOP NAVBAR -->
        <header class="top-bar">
            <div class="top-bar-left">

                <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Toggle Navigation">
                    <div class="hamburger-icon">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </button>

                <div class="brand-logo">
                    @{
                        DataEntryController dc = new DataEntryController();
                        string employerlogo = dc.GetEmployerLogo();

                        if (employerlogo != null)
                        {
                            FileInfo logoInfo = new FileInfo(Path.Combine(Server.MapPath("/Images"), employerlogo));
                            if (logoInfo.Exists)
                            {
                                //string directoryName = Path.GetDirectoryName(employerlogo);
                                //if (!directoryName.StartsWith(@"C:\", true, System.Globalization.CultureInfo.InvariantCulture))
                                //{
                                <img src="~/Images/@employerlogo" alt="Employer Logo" class="logo-img" />
                                //}
                            }
                        }
                    }
                    <span class="app-title">Soft Books Payroll</span>
                    @{
                        ui_utils utils = new ui_utils();
                        string version = utils.get_base_version();
                        <span class="app-version">@version</span>
                    }
                </div>

            </div>
            <!-- INTEGRATED LOGIN PARTIAL -->
            <div class="top-bar-right">
                @Html.Partial("_LoginPartial")
            </div>
        </header>
        <!-- MAIN WRAPPER (SIDEBAR + CONTENT) -->
        <div class="main-wrapper">
            <!-- LEFT SIDEBAR PANEL -->
            <aside id="sidebar" class="sidebar-panel">
                <nav class="sidebar-nav">
                    <ul>
                        <!-- Dashboard / Home -->
                        <li class="nav-item">
                            @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { id = "home-form" }))
                            {
                                <a id="btnSubmitIndexForm" class="nav-link">
                                    <i class="fa-solid fa-house nav-icon"></i>
                                    <span class="nav-label">Dashboard</span>
                                </a>
                            }
                        </li>
                        @if (Request.IsAuthenticated)
                        {
                            AdministratorController ac = new AdministratorController();
                            string email = User.Identity.Name;

                            if (ac._IsRoleMenusAllowed(email, "btn_employers"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllEmployers", "DataEntry", FormMethod.Get, new { id = "employers-form" }))
                                    {
                                        <a id="btnSubmitGetAllEmployersForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Employers</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_employees"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllEmployees", "DataEntry", FormMethod.Get, new { id = "employees-form" }))
                                    {
                                        <a id="btnSubmitGetAllEmployeesForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Employees</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_departments"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllDepartments", "Departments", FormMethod.Get, new { id = "departments-form" }))
                                    {
                                        <a id="btnSubmitGetAllDepartmentsForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Departments</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_payroll_items"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllPayrollItems", "PayrollItems", FormMethod.Get, new { id = "payroll-items-form" }))
                                    {
                                        <a id="btnSubmitGetAllPayrollItemsForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Payroll Items</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_benefits"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllBenefits", "Benefits", FormMethod.Get, new { id = "benefits-form" }))
                                    {
                                        <a id="btnSubmitGetAllBenefitsForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Benefits</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_banks"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllBanks", "Banks", FormMethod.Get, new { id = "banks-form" }))
                                    {
                                        <a id="btnSubmitGetAllBanksForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Banks</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_payee_rates"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllPayeeRates", "DataEntry", FormMethod.Get, new { id = "payee-rates-form" }))
                                    {
                                        <a id="btnSubmitGetAllPayeeRatesForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">PAYE Rates</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_new_nssf"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllNewNSSFComputaion", "DataEntry", FormMethod.Get, new { id = "new-nssf-computation-form" }))
                                    {
                                        <a id="btnSubmitNewNSSFComputaionForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">NSSF Computation</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_nhif_rates"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllNhifRates", "DataEntry", FormMethod.Get, new { id = "nhif-rates-form" }))
                                    {
                                        <a id="btnSubmitGetAllNhifRatesForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">NHIF Rates</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_settings"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllSettings", "Administrator", FormMethod.Get, new { id = "settings-form" }))
                                    {
                                        <a id="btnSubmitGetAllSettingsForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Settings</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_payrolls"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllPayrolls", "Payrolls", FormMethod.Get, new { id = "payrolls-form" }))
                                    {
                                        <a id="btnSubmitGetAllPayrollsForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">All Payrolls</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_process_payroll"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("ProcessPayroll", "Payrolls", FormMethod.Get, new { id = "process-payroll-form" }))
                                    {
                                        <a id="btnSubmitProcessPayrollForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Process Payroll</span>
                                        </a>
                                    }

                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_reports"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllReports", "DataEntry", FormMethod.Get, new { id = "reports-form" }))
                                    {
                                        <a id="btnSubmitGetAllReportsForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Reports</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_tax_calculator"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllTaxCalculator", "DataEntry", FormMethod.Get, new { id = "tax-calculator-form" }))
                                    {
                                        <a id="btnSubmitGetAllTaxCalculatorForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Tax Calculator</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_roles"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllRoles", "Administrator", FormMethod.Get, new { id = "roles-form" }))
                                    {
                                        <a id="btnSubmitGetAllRolesForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Roles</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_users"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllUsers", "Administrator", FormMethod.Get, new { id = "users-form" }))
                                    {
                                        <a id="btnSubmitGetAllUsersForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Users</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_users_in_roles"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllUSersRoles", "Administrator", FormMethod.Get, new { id = "user-roles-form" }))
                                    {
                                        <a id="btnSubmitGetAllUSersRolesForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Users Roles</span>
                                        </a>
                                    }
                                </li>
                            }

                            if (ac._IsRoleMenusAllowed(email, "btn_rights"))
                            {
                                <li class="nav-item">
                                    @using (Html.BeginForm("GetAllRights", "Administrator", FormMethod.Get, new { id = "rights-form" }))
                                    {
                                        <a id="btnSubmitGetAllRightsForm" class="nav-link">
                                            <i class="fa-solid fa-house nav-icon"></i>
                                            <span class="nav-label">Rights</span>
                                        </a>
                                    }
                                </li>
                            }


                        }


                        <!-- Help Section -->
                        <li class="nav-item has-treeview">
                            <a class="nav-link menu-dropdown">
                                <i class="fa-solid fa-circle-question nav-icon"></i>
                                <span class="nav-label">Help</span>
                                <i class="fa-solid fa-chevron-right arrow-icon"></i>
                            </a>
                            <ul class="treeview-menu">
                                <li>
                                    @using (Html.BeginForm("Help", "Home", FormMethod.Get, new { id = "help-form" }))
                                    {
                                        <a id="btnSubmitHelpForm" class="nav-link">Help Center</a>
                                    }
                                </li>
                                <li>
                                    @using (Html.BeginForm("ContactUs", "Home", FormMethod.Get, new { id = "contact-us-form" }))
                                    {
                                        <a id="btnSubmitContactUsForm" class="nav-link">Contact Us</a>
                                    }
                                </li>
                                <li>
                                    @using (Html.BeginForm("About", "Home", FormMethod.Get, new { id = "about-form" }))
                                    {
                                        <a id="btnSubmitAboutForm" class="nav-link">About</a>
                                    }
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>
            </aside>

            <!-- Global Reusable Spinner Overlay -->
            <div id="globalSpinnerOverlay" class="spinner-overlay displaynone">
                <div class="spinner-card">
                    <div class="spinner"></div>
                    <p id="globalSpinnerText" class="spinner-text">Processing, please wait...</p>
                </div>
            </div>

            <!-- Global Reusable Toast Notification Container -->
            <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

            <!-- MAIN WORKSPACE CONTENT -->
            <main id="mainContent" class="main-content-wrapper">
                <div id="error-display-div" class="error-banner displaynone"></div>
                @RenderSection("featured", required: false)
                <div class="content-body">
                    @RenderBody()
                </div>
                <!-- FOOTER -->
                <footer class="app-footer">
                    <div class="footer-links">
                        @Html.ActionLink("Home", "Index", "Home")
                        @Html.ActionLink("About", "About", "Home")
                        @Html.ActionLink("Contacts", "Contact", "Home")
                        @Html.ActionLink("Help", "Help", "Home")
                        <a href="#" title="Terms">Terms</a>
                        <a href="#" title="Privacy Policy">Privacy Policy</a>
                    </div>
                    <div class="footer-copyright">
                        <p>&copy; @DateTime.Now.Year Software Providers Limited. All Rights Reserved.</p>
                    </div>
                </footer>
            </main>

            <!-- Modern Cookie Consent Modal Banner -->
            <div id="cookieConsentBanner" class="cookie-banner displaynone" role="dialog" aria-live="polite" aria-label="Cookie Preferences">
                <div class="cookie-card">
                    <div class="cookie-header">
                        <h3>Cookie & Privacy Settings</h3>
                        <p>We use cookies and local storage to enhance your experience, analyze site traffic, and personalize content.</p>
                    </div>
                    <div class="cookie-options">
                        <div class="cookie-option">
                            <div class="option-info">
                                <span class="option-title">Essential</span>
                                <span class="option-desc">Necessary for the website to function properly (e.g., authentication, security).</span>
                            </div>
                            <input type="checkbox" id="chkEssential" checked disabled aria-label="Essential Cookies" />
                        </div>
                        <div class="cookie-option">
                            <div class="option-info">
                                <span class="option-title">Analytics</span>
                                <span class="option-desc">Helps us understand how visitors interact with the site to improve performance.</span>
                            </div>
                            <input type="checkbox" id="chkAnalytics" aria-label="Analytics Cookies" />
                        </div>
                        <div class="cookie-option">
                            <div class="option-info">
                                <span class="option-title">Marketing</span>
                                <span class="option-desc">Used to deliver relevant advertisements and track campaign effectiveness.</span>
                            </div>
                            <input type="checkbox" id="chkMarketing" aria-label="Marketing Cookies" />
                        </div>
                    </div>
                    <div class="cookie-actions">
                        <button type="button" id="btnRejectAll" class="btn-cookie btn-cookie-secondary">Reject Optional</button>
                        <button type="button" id="btnSaveCustom" class="btn-cookie btn-cookie-outline">Save Selection</button>
                        <button type="button" id="btnAcceptAll" class="btn-cookie btn-cookie-primary">Accept All</button>
                    </div>
                </div>
            </div>
            


        </div>
    </div>



    @RenderSection("scripts", required: false)
    <!-- Sidebar & Accordion Toggle Script -->
    <script type="text/javascript">
        $(document).ready(function () {

            $('#sidebarToggle').on('click', function () {
                $('body').toggleClass('sidebar-collapsed');
                $('#sidebar').toggleClass('collapsed');
                $('#mainContent').toggleClass('expanded');
            });

            // Accordion treeview behavior
            $('.menu-dropdown').on('click', function (e) {
                e.preventDefault();
                var $parent = $(this).closest('.has-treeview');
                $parent.toggleClass('open');
                $parent.find('.treeview-menu').slideToggle(200);
            });
        });
    </script>
</body>
</html>
