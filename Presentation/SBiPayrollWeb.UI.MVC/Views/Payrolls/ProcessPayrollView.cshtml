@model IEnumerable<SBiPayrollWeb.Entities.Payroll>
@{
    ViewBag.Title = "Process Payrolls";
    int payrollCount = Model != null ? Model.Count() : 0;
}
<link rel="stylesheet" href="~/Content/process_payroll_modern.css" />
<div class="payrolls-container">
    <!-- Header Section -->
    <div class="page-header">
        <div class="header-title">
            <h2>Process Payrolls</h2>
            <span class="badge-count" id="totalCount">@payrollCount</span>
        </div> 
    </div>
    <!-- Utility Bar: Search & Filters -->
    <div class="table-utilities">
        <div class="search-box">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="payrollSearchInput" placeholder="Search by name, email, or payroll no..." />
            <button type="button" id="clearSearch" class="btn-clear" style="display: none;">&times;</button>
        </div>
        <div class="page-size-selector">
            <label for="pageSizeSelect">Rows per page:</label>
            <select id="pageSizeSelect">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
    <!-- Table Container -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="modern-table" id="payrollsTable">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Period)</th>
                        <th>@Html.DisplayNameFor(model => model.Year)</th>
                        <th>@Html.DisplayNameFor(model => model.EmployerId)</th>
                        <th>@Html.DisplayNameFor(model => model.DateRun)</th>
                        <th>@Html.DisplayNameFor(model => model.RunBy)</th>
                        <th>@Html.DisplayNameFor(model => model.Approved)</th>
                        <th>@Html.DisplayNameFor(model => model.ApprovedBy)</th>
                        <th>@Html.DisplayNameFor(model => model.IsOpen)</th>
                        <th>@Html.DisplayNameFor(model => model.Processed)</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="payrollTableBody">
                    @foreach (var item in Model)
                    {
                        <tr class="payroll-row">
                            <td><strong>@Html.DisplayFor(modelItem => item.Period)</strong></td>
                            <td>@Html.DisplayFor(modelItem => item.Year)</td>
                            <td>@Html.DisplayFor(modelItem => item.EmployerId)</td>
                            <td>
                                @Html.TextBoxFor(model => item.DateRun, new
                            {
                                Value = item.DateRun.ToString("yyyy-MM-dd"),
                                @readonly = "readonly",
                                @class = "payroll-date-input",
                                type = "date"
                            })
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.RunBy)</td>
                            <td>
                                <span class="status-badge @(item.Approved ? "status-true" : "status-false")">
                                    @(item.Approved ? "Approved" : "Pending")
                                </span>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.ApprovedBy)</td>
                            <td>
                                <span class="status-badge @(item.IsOpen ? "status-true" : "status-false")">
                                    @(item.IsOpen ? "Open" : "Closed")
                                </span>
                            </td>
                            <td>
                                <span class="status-badge @(item.Processed ? "status-true" : "status-false")">
                                    @(item.Processed ? "Yes" : "No")
                                </span>
                            </td>
                            <td class="action-links text-right">
                                <button type="button"
                                        class="btn-process btn_process_payroll"
                                        data-year="@item.Year"
                                        data-period="@item.Period">
                                    Process
                                </button>
                                <button type="button"
                                        class="btn-close btn_close_payroll"
                                        data-year="@item.Year"
                                        data-period="@item.Period">
                                    Close
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="noResults" class="no-results" style="display: none;">
                <p>No matching payrolls found.</p>
            </div>
        </div>
        <!-- Table Footer Pagination -->
        <div class="pagination-footer">
            <div class="pagination-info" id="paginationInfo">
                Showing 0 to 0 of 0 entries
            </div>
            <div class="pagination-controls" id="paginationControls">
                <!-- Pagination buttons generated by JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- Progress Spinner -->
<div id="progress" class="loading-overlay" style="display: none;">
    <div class="spinner"></div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/process_payroll_modern.js"></script>
}
