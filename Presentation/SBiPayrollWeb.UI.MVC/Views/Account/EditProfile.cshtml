@model SBiPayrollWeb.Entities.spUser
@{
    ViewBag.Title = "Edit Profile";
}
<link rel="stylesheet" href="~/Content/edit_profile_modern.css" />
<div class="profile-container">
    <div class="profile-header">
        <h2>Edit Profile</h2>
        <p>Update your personal details, contact preferences, and security settings.</p>
    </div>
    @using (Html.BeginForm("EditProfile", "Account", FormMethod.Post, new { enctype = "multipart/form-data", id = "edit-profile-form", @class = "profile-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        @Html.HiddenFor(model => model.Id)

        <div class="profile-layout">
            <!-- Left Column: User Details -->
            <div class="profile-main">
                <!-- Personal Details Section -->
                <div class="form-card">
                    <h3 class="card-title">Personal Information</h3>

                    <div class="form-grid">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.Email, new { @disabled = "disabled", @class = "form-control", placeholder = "Enter Email" })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Surname, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.Surname, new { @class = "form-control", placeholder = "Enter surname" })
                            @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.OtherNames, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.OtherNames, new { @class = "form-control", placeholder = "Enter other names" })
                            @Html.ValidationMessageFor(model => model.OtherNames, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.NationalID, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.NationalID, new { @class = "form-control", placeholder = "Enter National ID" })
                            @Html.ValidationMessageFor(model => model.NationalID, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Gender, new { @class = "form-label" })
                            @{
        var genderList = new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Male", Value = "M" },
                                    new SelectListItem { Text = "Female", Value = "F" }
                                };
                            }
                            @Html.DropDownListFor(model => model.Gender, genderList, "-- Select Gender --", new { @class = "form-control select-control" })
                            @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.DateOfBirth, new { @class = "form-label" })
                            @{
        string dobFormatted = (Model.DateOfBirth == DateTime.MinValue || Model.DateOfBirth.Year == 1)
            ? DateTime.Now.ToString("yyyy-MM-dd")
            : Model.DateOfBirth.ToString("yyyy-MM-dd");
                            }
                            @Html.TextBoxFor(model => model.DateOfBirth, new { Value = dobFormatted, @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.InformBy, new { @class = "form-label" })
                            @{
        var informList = new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "SMS", Value = "SMS" },
                                    new SelectListItem { Text = "EMAIL", Value = "EMAIL", Selected = true }
                                };
                            }
                            @Html.DropDownListFor(model => model.InformBy, informList, "-- Select Inform By --", new { @class = "form-control select-control" })
                            @Html.ValidationMessageFor(model => model.InformBy, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group full-width">
                            @Html.LabelFor(model => model.Telephone, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Telephone, new { @class = "form-control", type = "tel", placeholder = "254717769329" })
                            @Html.ValidationMessageFor(model => model.Telephone, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <!-- Password & Security Section with Strength Meter -->
                <div class="form-card">
                    <h3 class="card-title">Security Settings</h3>
                    <div class="form-grid">
                        <div class="form-group full-width">

                            <label for="Password" class="form-label">Password</label>
                            <div class="password-wrapper">
                                <input type="password" id="Password" name="Password" class="form-control" placeholder="Enter password or leave blank to keep current" autocomplete="new-password" />
                                <button type="button" class="btn-toggle-password" id="togglePasswordBtn" aria-label="Toggle password visibility">
                                    <svg class="eye-icon" id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                            </div>

                            <!-- Password Strength Indicator UI -->
                            <div class="password-strength-container" id="strengthContainer" style="display: none;">
                                <div class="strength-bar-wrapper">
                                    <div class="strength-bar-fill" id="strengthBar"></div>
                                </div>
                                <div class="strength-label-text">
                                    Strength: <span id="strengthText">None</span>
                                </div>
                                <ul class="password-criteria-list">
                                    <li id="ruleLength" class="invalid">At least 8 characters</li>
                                    <li id="ruleLower" class="invalid">Lowercase letter (a-z)</li>
                                    <li id="ruleUpper" class="invalid">Uppercase letter (A-Z)</li>
                                    <li id="ruleNumber" class="invalid">Number (0-9)</li>
                                    <li id="ruleSpecial" class="invalid">Special character (!@@#$%^&*)</li>
                                </ul>
                            </div>

                        </div>
                    </div>


                </div>


                <!-- Right Column: Profile Photo Card -->
                <!-- Right Column: Interactive Profile Photo Card -->
                <div class="profile-sidebar">
                    <div class="form-card photo-card">
                        <h3 class="card-title">Profile Picture</h3>

                        <div class="photo-preview-wrapper">
                            @{
        // 1. Default fallback image located in the ~/Images/uploads/ directory
        string photo_Path = "~/Images/uploads/defaultphoto.jpg";

        if (!string.IsNullOrEmpty(Model.Photo))
        {
            // Extract filename in case Model.Photo contains a leading slash or relative prefix
            string fileName = Path.GetFileName(Model.Photo);

            // Construct the physical server path to verify file existence
            string physicalPath = Server.MapPath("~/Images/uploads/" + fileName);

            if (File.Exists(physicalPath))
            {
                // Set the virtual path to the uploaded image
                photo_Path = "~/Images/uploads/" + fileName;
            }
        }
                            }
                            <img src="@Url.Content(photo_Path)" alt="Profile Picture" class="profile-avatar" id="avatarPreview" data-default-src="@Url.Content(photo_Path)" />

                        </div>


                        <!-- Hidden File Input for Image Upload -->
                        <input type="file" id="PhotoUploadInput" name="PhotoUpload" accept="image/*" class="displaynone" />
                        <div class="photo-actions">
                            <label for="PhotoUploadInput" class="btn btn-outline">Choose New Image</label>
                            <button type="button" id="btnCancelPhoto" class="btn btn-text text-danger displaynone">Cancel Preview</button>
                        </div>


                    </div>
                </div>



                <div class="form-actions">
                    <button type="submit" id="btnSubmit" class="btn btn-primary">Save Changes</button>
                </div>




            </div>


        </div>

    }


</div>

@section Scripts {
    <script src="~/Scripts/edit_profile_modern.js"></script>
}

